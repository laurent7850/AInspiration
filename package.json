{
  "name": "distr-action-sprl",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "tsc && vite build --mode production",
    "build:dev": "tsc && vite build --mode development",
    "build:prod": "tsc && vite build --mode production",
    "postbuild": "node scripts/check-public-matches-head.mjs && node scripts/generate-dist-manifest.mjs",
    "postbuild:prod": "node scripts/check-public-matches-head.mjs && node scripts/generate-dist-manifest.mjs",
    "postbuild:dev": "node scripts/generate-dist-manifest.mjs",
    "preview": "vite preview",
    "preview:prod": "vite build --mode production && vite preview",
    "deploy": "npm run build:prod && echo '✅ Build production prêt dans dist/'",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "check:public": "node scripts/check-public-matches-head.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "js-cookie": "^3.0.5",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.4.35",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
